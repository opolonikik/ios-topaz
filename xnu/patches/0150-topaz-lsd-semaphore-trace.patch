diff --git a/osfmk/kern/sync_sema.c b/osfmk/kern/sync_sema.c
--- a/osfmk/kern/sync_sema.c
+++ b/osfmk/kern/sync_sema.c
@@ -55,6 +55,36 @@
 #include <kern/waitq.h>
 #include <kern/zalloc.h>
 #include <kern/mach_param.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* Opt-in semaphore trace. Disabled unless sweetsem=1. */
+#include <pexpert/pexpert.h>
+#include <sys/proc.h>
+#include <libkern/libkern.h>
+
+static int sweetsem_enabled = -1;
+static unsigned int sweetsem_lines;
+
+static bool
+sweetsem_lsd_log(void)
+{
+	if (sweetsem_enabled < 0) {
+		uint32_t on = 0;
+		(void)PE_parse_boot_argn("sweetsem", &on, sizeof(on));
+		sweetsem_enabled = on ? 1 : 0;
+	}
+	if (!sweetsem_enabled || sweetsem_lines >= 600) {
+		return false;
+	}
+	char name[32] = { 0 };
+	proc_selfname(name, sizeof(name));
+	if (strcmp(name, "lsd") != 0) {
+		return false;
+	}
+	++sweetsem_lines;
+	return true;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
 
